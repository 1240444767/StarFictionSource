      "summary": "//div[@class='intro']",
      "chapterList": "//div[@class='chapters'][p[contains(text(),'全部章节')]]/ul/li[a]",
      "chapterName": "./a",
      "chapterUrl": "./a/@href",
      "chapterListNextPage": "//div[@class='listpage']//a[contains(text(),'下一页')]/@href"
    },
    "content": {
