    "name": "掌阅中文",
    "domain": "m.newqy.com",
    "charset": "utf-8",
    "useWebView": true,
    "search": {
      "url": "https://m.newqy.com/user/search.html?q={{key}}",
      "method": "GET",
      "body": "",
      "list": "@js:var r=[];document.querySelectorAll('#main .search article, #main .search .image').forEach(function(el){var img=el.querySelector('img');var
  title=el.querySelector('.title');var info=el.closest('.search')||el.parentElement;var ps=info.querySelectorAll('p');var
  author='';ps.forEach(function(p){if(p.textContent.indexOf('作者')>=0)author=p.textContent.replace('作者：','').trim();});var
  a=el.querySelector('a[href]');r.push({name:title?title.textContent.trim():'',author:author,cover:img?img.getAttribute('src'):'',detailUrl:a?a.getAttribute('href'):''});});return
   JSON.stringify(r);"
    },
    "detail": {
      "cover": "//meta[@property='og:image']/@content",
      "name": "//h2[@class='title']",
      "author": "//meta[@property='og:novel:author']/@content",
      "summary": "//div[@class='introbar']",
      "chapterList": "//ul[@class='chapter']/li/a",
      "chapterName": ".",
      "chapterUrl": "./@href",
      "chapterListNextPage": ""
    },
    "content": {
      "text": "//div[@id='text']",
      "nextPage": "",
      "urlReplaceFrom": "",
      "urlReplaceTo": "",
      "filters": ["//script"]
    }
  }
]
