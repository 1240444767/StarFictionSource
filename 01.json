[
  {
    "name": "笔书网",
    "domain": "www.biqukun.org",
    "charset": "utf-8",
    "userAgent": "",
    "search": {
      "url": "http://www.biqukun.org/modules/article/search.php?searchkey={{key}}",
      "method": "GET",
      "body": "",
      "list": "//table[@class='grid']//tr[td]",
      "name": "td[1]/a",
      "author": "td[3]",
      "cover": "",
      "detailUrl": "td[1]/a/@href",
      "latestChapter": "td[2]//a"
    },
    "detail": {
      "cover": "//div[@id='fmimg']/img/@src",
      "name": "//meta[@property='og:novel:book_name']/@content",
      "author": "//meta[@property='og:novel:author']/@content",
      "summary": "//div[@id='intro']",
      "chapterList": "//div[@id='list']//dd/a",
      "chapterName": ".",
      "chapterUrl": "./@href",
      "chapterListNextPage": ""
    },
    "content": {
      "text": "//div[@id='content']",
      "nextPage": "",
      "urlReplaceFrom": "",
      "urlReplaceTo": "",
      "filters": ["//script", "//center", "//div[@class='footer']"]
    }
  },
  {
    "name": "PO18 手机版",
    "domain": "wap.po18.work",
    "charset": "utf-8",
    "userAgent": "",
    "search": {
      "url": "https://wap.po18.work/s.php",
      "method": "POST",
      "body": "searchkey={{key}}&page=1",
      "list": "/html/body/div[2]/ul/li",
      "name": "h2/a",
      "author": "span[@class='author']",
      "cover": "a[@class='top_img']/img/@src",
      "detailUrl": "h2/a/@href",
      "latestChapter": ""
    },
    "detail": {
      "cover": "//div[@class='fm']/img/@src",
      "name": "//h1",
      "author": "//meta[@property='og:novel:author']/@content",
      "summary": "//div[@class='intro']",
      "chapterList": "//div[@class='chapters'][p[contains(text(),'全部章节')]]/ul/li[a]",
      "chapterName": "./a",
      "chapterUrl": "./a/@href",
      "chapterListNextPage": "//div[@class='listpage']//a[contains(text(),'下一页')]/@href"
    },
    "content": {
      "text": "//div[@id='content']",
      "nextPage": "",
      "filters": ["//script", "//div[@class='chapterpage']", "//div[@class='recommend']"]
    }
  },{
    "name": "爱下电子书",
    "domain": "ixdzs8.com",
    "charset": "utf-8",
    "useWebView": true,
    "search": {
      "url": "https://ixdzs8.com/bsearch?q={{key}}",
      "method": "GET",
      "body": "",
      "list": "//ul[@class='u-list']/li",
      "name": ".//h3[@class='bname']/a",
      "author": ".//span[@class='bauthor']/a",
      "cover": ".//div[@class='l-img']/a/img/@src",
      "detailUrl": ".//h3[@class='bname']/a/@href",
      "latestChapter": ".//p[@class='l-last']/a/span[@class='l-chapter']",
      "jsExtract": ""
    },
    "detail": {
      "cover": "//div[@class='n-img']/img/@src",
      "name": "//h1",
      "author": "//a[@class='bauthor']",
      "summary": "//p[@id='intro']",
      "chapterList": "//ul[contains(@class,'u-chapter')]/li/a",
      "chapterName": ".",
      "chapterUrl": "./@href",
      "chapterListNextPage": "",
      "jsExtract": "(function(){var b=document.querySelector('.catalog-all');if(b)b.click();var c=document.querySelector('#a-list
  .u-chapter');if(!c||c.children.length===0){c=document.querySelector('.cfirst');}var r=[];if(c){c.querySelectorAll('li
  a').forEach(function(a){r.push({name:a.textContent.trim(),url:a.getAttribute('href')});});}return JSON.stringify(r);})()"
    },
    "content": {
      "text": "//article[@class='page-content']//p",
      "nextPage": "//a[contains(@class,'chapter-next')]/@href",
      "urlReplaceFrom": "",
      "urlReplaceTo": "",
      "filters": ["//script", "//ins", "//div[contains(@id,'bg-ssp')]"],
      "jsExtract": ""
    }
  }
]
